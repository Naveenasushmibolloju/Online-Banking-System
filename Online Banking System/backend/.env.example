# Environment
NODE_ENV=development

# Server
PORT=5000

# MongoDB - Use MongoDB Atlas for production
# Development: mongodb://localhost:27017/online-banking
# Production: mongodb+srv://username:password@cluster.mongodb.net/online-banking
MONGO_URI=mongodb://localhost:27017/online-banking

# JWT - Use a strong random string in production
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Frontend URL - Update for production
FRONTEND_URL=http://localhost:5173

# Production Examples:
# NODE_ENV=production
# PORT=10000
# MONGO_URI=mongodb+srv://admin:password@cluster0.xxxxx.mongodb.net/online-banking?retryWrites=true&w=majority
# JWT_SECRET=super-secure-random-string-here
# JWT_EXPIRE=7d
# FRONTEND_URL=https://your-app.onrender.com
